{
  "name": "app-derecho-comparado",
  "version": "1.0.0",
  "description": "Plataforma interactiva: Asociaciones Público-Privadas en Colombia, Francia y Estados Unidos",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test --test-timeout=120000 \"tests/e2e/*.test.mjs\"",
    "test:stress": "node --disable-warning=ExperimentalWarning tests/stress.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
